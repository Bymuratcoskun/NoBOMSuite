<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NoBOMSuite.Desktop.SolutionReviewWindow"
        Title="AI Çözüm İnceleme Penceresi"
        Width="800" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SystemRegionBrush}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="🤖 Ajan 2 Tarafından Üretilen Güvenli Yama (Fark Görünümü)" FontSize="18" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,15" />
        
        <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" BorderBrush="#45475A" BorderThickness="1">
            <ScrollViewer Padding="15">
                <StackPanel x:Name="DiffLinesContainer" Spacing="2" />
            </ScrollViewer>
        </Border>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Spacing="15">
            <Button Content="İptal Et" Click="Cancel_Click" Padding="15,8" />
            <Button Content="Yamayı Uygula" Click="Apply_Click" Background="#A6E3A1" Foreground="#1E1E2E" FontWeight="Bold" Padding="15,8" />
        </StackPanel>
    </Grid>
</Window>