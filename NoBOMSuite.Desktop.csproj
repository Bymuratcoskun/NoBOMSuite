<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- GirCore parameterless constructor and diagnostics warnings -->
    <NoWarn>$(NoWarn);NU1603;NU1903;GirCore1007</NoWarn>
      <!-- Düz dizin yapısı: varsayılan glob Core'un ve testlerin dosyalarını da
         toplar. Eskiden uzun bir <Compile Remove> KARA LİSTESİ vardı ve Core'a
         eklenen her yeni dosya burayı SESSİZCE bozuyordu: 2026-08-30'da
         BomConfigKoleksiyonu.cs (test dosyası) eklenince masaüstü uygulaması
         derlenmez oldu, üstelik beş Core dosyası çift derleniyordu (CS0436).
         Core/CLI/Native ile aynı kurala geçildi: AÇIK liste. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GirCore.Gtk-4.0" Version="0.8.0" />
    <PackageReference Include="GirCore.Adw-1" Version="0.8.0" />
    <ProjectReference Include="SanitizerKit.Core.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- Yalnız masaüstü uygulamasına AİT olanlar; gerisi SanitizerKit.Core'dan gelir. -->
    <Compile Include="Program.cs" />
    <Compile Include="MainWindow.cs" />
    <Compile Include="WelcomeWindow.cs" />
    <Compile Include="ConflictResolutionWindow.cs" />
    <Compile Include="SolutionReviewWindow.cs" />
    <Compile Include="DashboardView.cs" />
    <Compile Include="LogViewerView.cs" />
    <Compile Include="DispatcherShim.cs" />
    <Compile Include="BackgroundWatcher.cs" />
    <Compile Include="AiOrchestrator.cs" />
  </ItemGroup>

</Project>
