<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NoBOMSuite.Desktop"
        x:Class="NoBOMSuite.Desktop.MainWindow"
        Title="NoBOMSuite - Merkezi Yönetim Paneli"
        Width="900" Height="650"
        Background="#1E1E2E">
        
    <Grid RowDefinitions="Auto, *, 220" Margin="25">
        <!-- 1. Başlık & İnteraktif Mod (Header) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="20" Margin="0,0,0,25">
            <TextBlock Text="🛡️ DevGuard Kumanda Merkezi" FontSize="26" FontWeight="Bold" Foreground="White"/>
            <CheckBox x:Name="AutoFixCheckBox" Content="Otomatik Onarım Modu (Anında Düzelt)" 
                      Checked="AutoFix_Changed" Unchecked="AutoFix_Changed" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <Button Content="🔗 Git Hook Kur" Click="InstallGitHook_Click" 
                    Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="🧩 VS Code Eklentisi Kur" Click="InstallVsCodeExtension_Click" 
                    Background="#89DCEB" Foreground="#11111B" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="💾 Taşınabilir Sürüm" Click="ExportPortable_Click" 
                    Background="#F9E2AF" Foreground="#11111B" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="🪄 AI Çözüm" Click="AiFix_Click" 
                    Background="#CBA6F7" Foreground="#11111B" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- 2. Sürükle ve Bırak Alanı -->
        <Border Grid.Row="1" BorderBrush="#313244" BorderThickness="2" CornerRadius="12" 
            Background="#181825" x:Name="DragDropBorder" Margin="0,0,0,20">
            <Grid>
                <!-- Görünmez TextBox (Linux Wayland'da dosya yollarını yakalamak için tüm çerçeveyi kaplar) -->
                <TextBox x:Name="HiddenWaylandDropZone" Background="Transparent" Foreground="Transparent" 
                         BorderThickness="0" CaretBrush="Transparent" Cursor="Arrow"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         TextChanged="HiddenWaylandDropZone_TextChanged"
                         Opacity="0.01"/>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                    <!-- Yazı ve ikonların olayları yutmasını engelliyoruz (IsHitTestVisible="False") -->
                    <StackPanel Spacing="15" IsHitTestVisible="False">
                        <TextBlock Text="📁" FontSize="64" HorizontalAlignment="Center" Foreground="#89B4FA"/>
                        <TextBlock Text="Taranacak Dosya veya Klasörleri Buraya Sürükleyin" 
                                   FontSize="18" Foreground="#BAC2DE" HorizontalAlignment="Center"/>
                    </StackPanel>

                <Button x:Name="BrowseButton" Content="Veya Bilgisayardan Gözat..." Click="BrowseFiles_Click"
                        Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"
                        HorizontalAlignment="Center" Padding="20,10" CornerRadius="6" Margin="0,10,0,0"/>
                
                <!-- Manuel giriş eklentisi (DBus/GTK olmayan sistemler için yedek plan) -->
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBox x:Name="ManualPathInput" Watermark="Veya dosya yolunu buraya yapıştırın..." Width="350" Background="#11111B" Foreground="#BAC2DE" Padding="10" KeyDown="ManualPathInput_KeyDown"/>
                    <Button Content="Tara" Click="ManualScan_Click" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Padding="15,8"/>
                    <Button x:Name="FixPendingButton" Content="🛠️ Sorunları Onar (0)" Click="FixPending_Click" IsVisible="False" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" Padding="15,8"/>
                </StackPanel>
            </StackPanel>
            </Grid>
        </Border>
        
        <!-- 3. Pano & Canlı Konsol Sekmeleri -->
        <Border Grid.Row="2" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" 
                Background="#11111B" Padding="5">
            <TabControl>
                <TabItem Header="📊 Pano">
                    <local:DashboardView x:Name="DashboardPanel" />
                </TabItem>
                <TabItem Header="📟 Canlı Konsol">
                    <ScrollViewer x:Name="ConsoleScroller" Padding="10,10,10,20">
                        <StackPanel x:Name="LiveConsolePanel" Spacing="2" Margin="0,0,0,15" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
