{
  "name": "nobomsuite",
  "version": "0.1.0",
  "description": "BOM ve görünmez karakter avcısı — tarama çekirdeği native C-API üzerinden çalışır.",
  "main": "./extension.js",
  "scripts": {
    "test": "node testler/eklenti-testi.js"
  },
  "keywords": [
    "bom",
    "sanitizer",
    "linter",
    "devguard"
  ],
  "author": "NoBOMSuite Team",
  "license": "MIT",
  "dependencies": {
    "koffi": "^3.1.6"
  },
  "allowScripts": {
    "koffi@3.1.6": true
  },
  "displayName": "DevGuard (NoBOMSuite)",
  "publisher": "bymuratcoskun",
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devguard.calismaAlaniniTara",
        "title": "Çalışma alanını tara",
        "category": "DevGuard"
      },
      {
        "command": "devguard.bomuKaldir",
        "title": "Bu dosyadaki BOM'u kaldır",
        "category": "DevGuard"
      }
    ],
    "configuration": {
      "title": "DevGuard",
      "properties": {
        "devguard.etkin": {
          "type": "boolean",
          "default": true,
          "description": "DevGuard tanılamalarını aç/kapa."
        },
        "devguard.kaydettesTara": {
          "type": "boolean",
          "default": true,
          "description": "Dosya kaydedildiğinde otomatik tara."
        },
        "devguard.taramaDeseni": {
          "type": "string",
          "default": "**/*.{cs,js,jsx,ts,tsx,py,rs,c,h,cpp,hpp,fs,fsx,go,java,kt,rb,php,sh,json,yml,yaml,toml,xml,csproj,sln}",
          "description": "Çalışma alanı taramasında hangi dosyalar okunsun."
        },
        "devguard.haricDesen": {
          "type": "string",
          "default": "**/{node_modules,bin,obj,target,dist,out,build,.git,.nobom,__pycache__,.venv,venv,vendor,coverage,data,datasets,.vscode-test}/**",
          "description": "Taramadan hariç tutulacak dizinler. Veri/külliyat dizinleri varsayılan olarak elenir: DevGuard kod hijyeni içindir, doğal dil metinlerinde ZWNJ/ZWJ meşrudur."
        },
        "devguard.enFazlaSorunluDosya": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "description": "Çalışma alanı taraması bu kadar sorunlu dosyada durur. Kapsam fazla genişse Sorunlar panelinin boğulmasını engeller."
        },
        "devguard.bomSerbestUzantilar": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".sln"
          ],
          "description": "BOM'un meşru sayıldığı uzantılar. Visual Studio .sln dosyalarını BOM ile yazar; kaldırmak araçları bozabilir."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "devguard.bomuKaldir",
          "group": "1_modification",
          "when": "editorTextFocus"
        }
      ],
      "explorer/context": [
        {
          "command": "devguard.bomuKaldir",
          "group": "7_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "devguard.bomuKaldir"
        },
        {
          "command": "devguard.calismaAlaniniTara"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bymuratcoskun/NoBOMSuite.git"
  },
  "bugs": {
    "url": "https://github.com/Bymuratcoskun/NoBOMSuite/issues"
  }
}
