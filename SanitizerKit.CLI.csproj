<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Native AOT Ayarları -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- SQLitePCLRaw.lib.e_sqlite3 NU1903 uyarısı: Microsoft.Data.Sqlite'ın geçişli bağımlılığıdır; bağımsız güncellenemez -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <!-- Düz dizin yapısı: varsayılan glob Core'un dosyalarını da toplar.
         Eskiden uzun bir <Compile Remove> KARA LİSTESİ vardı; Core'a eklenen her
         yeni dosya CLI'da çift derlenip CS0436 üretiyordu (2026-08-30'da AiTasiyici.cs
         ile canlı görüldü). Core.csproj'un kuralına geçildi: AÇIK liste. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="SanitizerKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CLI'ye AİT olan tek şey girdi noktası ve kendi uzantıları.
         Geri kalan her şey SanitizerKit.Core üzerinden gelir. -->
    <Compile Include="scripts/InvokeScan/Program.cs" />
    <Compile Include="PatchGeneratorExtensions.cs" />
  </ItemGroup>

</Project>
