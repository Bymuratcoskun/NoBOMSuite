# ── Derleme çıktısı ve ara dosyalar (üretilebilir, depoda durmaz) ──
bin/
obj/
*.user
*.suo

# ── Bağımlılıklar — package-lock.json izlenir, node_modules izlenmez ──
node_modules/

# ── Yayın çıktıları (dotnet publish) — geçmişte 90+ MB yer kaplamıştı ──
publish-desktop/
publish-cli/
*.dbg

# ── DevGuard'ın KENDİ yedek dizini — aracın çalışma verisi, kaynak değil ──
.nobom/

# ── Eklenti paketi (üretilebilir çıktı) ──
*.vsix
native/

# ── Üretilen çalışma verisi (2026-08-31) ──
devguard_auto.log
devguard_logs.db

# ── Kişisel IDE / araç ayarları — başkasının makinesinde anlamı yok ──
.idea/
.vscode/
.continue/
.vs/
