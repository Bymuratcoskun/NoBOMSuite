<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NoBOMSuite.Desktop.DashboardView">
    <Grid RowDefinitions="Auto, *" ColumnDefinitions="*, *" Margin="10">
        <!-- İstatistik Paneli -->
        <Border Grid.Row="0" Grid.Column="0" Padding="20" Margin="10" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="5">
                <TextBlock Text="Toplam Taranan Dosya" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TotalScannedText" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="#89B4FA" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="0" Grid.Column="1" Padding="20" Margin="10" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="5">
                <TextBlock Text="Toplam Bulunan Sorun" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TotalIssuesText" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="#F38BA8" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Son Aktiviteler Listesi -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="10" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8">
            <ListBox x:Name="ScanHistoryListBox" ItemsSource="{Binding ScanHistory}" Padding="5">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto, *, Auto" Margin="8,5" Width="600">
                            <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center" FontWeight="Medium"/>
                            <TextBlock Grid.Column="2" Text="{Binding Timestamp}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>